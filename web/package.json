{
  "name": "wuut-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Design harness for WUUT. Renders the app's screens in a browser so they can be captured into Figma — not a second implementation.",
  "scripts": {
    "tokens": "python3 ../scripts/extract_tokens.py",
    "tokens:check": "python3 ../scripts/extract_tokens.py --check",
    "dev": "vite",
    "build": "npm run tokens:check && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
